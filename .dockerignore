# What docker build never needs (the context is the repository root). Keeps the context small
# and, importantly, keeps secrets (deploy/.env) and local backups out of the image.
# Patterns are anchored to the root: the build DOES need e.g. packages/core/src/curvestudio/data.
/.git
/.github
/.remember
/.claude
/.superpowers
/.claude-*
/docs
# …except the one tracked file the web build needs: the SPA's prebuild copies the canonical
# help document into the bundle (see apps/web/scripts/sync-help.mjs).
!/docs/help-content.md
/examples
/scripts
/tests
/.venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
**/*.egg-info
**/node_modules
/apps/web/node_modules
/apps/web/dist
**/.env
/deploy/.env
/deploy/backups
/data
