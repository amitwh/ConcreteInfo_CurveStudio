# CurveStudio API settings. Copy to .env and edit; never commit real values.

# Database. SQLite for a single-user install, Postgres for a server:
#   CURVESTUDIO_DATABASE_URL=postgresql://curvestudio:CHANGE_ME@db:5432/curvestudio
CURVESTUDIO_DATABASE_URL=sqlite:///./data/curvestudio.db
# Where dev/test generate their JWT key pair and SQLite files live.
CURVESTUDIO_DATA_DIR=./data

# dev | test | prod. In prod both JWT keys are required and the API will not start without them.
CURVESTUDIO_ENV=dev

# RS256 key pair in PEM (newlines may be written as \n). Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out jwt_private.pem
#   openssl pkey -in jwt_private.pem -pubout -out jwt_public.pem
# Leave empty in dev: a pair is generated into CURVESTUDIO_DATA_DIR.
CURVESTUDIO_JWT_PRIVATE_KEY_PEM=
CURVESTUDIO_JWT_PUBLIC_KEY_PEM=

CURVESTUDIO_ACCESS_TTL_MIN=15
CURVESTUDIO_REFRESH_TTL_DAYS=14

# Upload limits: bytes per file and data rows per dataset.
CURVESTUDIO_MAX_UPLOAD_BYTES=20000000
CURVESTUDIO_MAX_ROWS=1000000

# Fit jobs: wall-clock budget per job, extra seconds before the watchdog kills a stuck worker,
# and the number of worker processes.
CURVESTUDIO_JOB_TIMEOUT_S=120
CURVESTUDIO_JOB_GRACE_S=10
CURVESTUDIO_JOB_WORKERS=2
# Fits waiting for a worker, over all users (more are refused with 503 QUEUE_FULL), and the
# largest fit result accepted from a job process, in bytes.
CURVESTUDIO_JOB_QUEUE_MAX=500
CURVESTUDIO_JOB_MAX_RESULT_BYTES=250000000

# Uploads are parsed in a separate short-lived process: wall-clock budget in seconds, how many
# may run at once overall (one per user), and extra memory (MB) the parser may use.
CURVESTUDIO_IMPORT_TIMEOUT_S=20
CURVESTUDIO_IMPORT_CONCURRENCY=2
CURVESTUDIO_IMPORT_MEMORY_MB=1024

# Per-user quotas. Empty = use the limits in the self-hosted plan row (200 datasets, 500 MB of
# dataset data, 2000 stored fits); set a number to override.
CURVESTUDIO_QUOTA_MAX_DATASETS=
CURVESTUDIO_QUOTA_MAX_DATASET_BYTES=
CURVESTUDIO_QUOTA_MAX_FITS=

# Seconds between purges of old refresh tokens and finished jobs (30 days retention).
CURVESTUDIO_HOUSEKEEPING_INTERVAL_S=3600

# Comma-separated explicit origins allowed to call the API from a browser. Never "*".
# Leave empty when the web app is served by the API itself (same origin).
CURVESTUDIO_CORS_ORIGINS=

CURVESTUDIO_REGISTRATION_ENABLED=true
CURVESTUDIO_BILLING_ENABLED=false

# Directory of the built web app (apps/web/dist) to serve from this process; empty = off.
CURVESTUDIO_WEB_DIST=

# Reverse proxies in front of the API (Traefik, Caddy, nginx...). The client address used for
# rate limits is the Nth entry from the RIGHT of X-Forwarded-For, N = this number: what each
# trusted proxy appended. Entries further left are supplied by the client and ignored.
# 1 = one proxy (the usual case); 0 = the API is reached directly, the header is ignored.
# Set it to the real number: too high lets clients pick their own address, too low rate-limits
# the proxy as a whole.
CURVESTUDIO_TRUSTED_PROXY_HOPS=1

# Process (uvicorn): host and port. The API parses X-Forwarded-For itself (above); uvicorn's
# own proxy-header handling is switched off.
CURVESTUDIO_HOST=127.0.0.1
CURVESTUDIO_PORT=8000
