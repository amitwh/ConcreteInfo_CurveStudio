# CurveStudio self-hosting settings. Copy to .env next to this file and edit:
#   cd deploy && cp .env.example .env
# Never commit the real .env (it holds the JWT signing keys). Every variable of the API is
# also documented in apps/api/.env.example; the full self-hosting guide is deploy/README.md.

# --- reverse proxy (used by docker-compose.yml and Caddyfile) -------------------------------------
# The public domain this instance is served on. DNS must point at this server. Caddy obtains
# and renews a Let's Encrypt certificate for it (ports 80 and 443 must be reachable).
CURVESTUDIO_DOMAIN=fit.example.com

# --- database --------------------------------------------------------------------------------------
# The Postgres container's credentials. The password must match the URL below; user and
# database name must match in both places.
CURVESTUDIO_DB_USER=curvestudio
CURVESTUDIO_DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
CURVESTUDIO_DB_NAME=curvestudio
# The app connects to the db service on the compose network (psycopg 3 driver).
CURVESTUDIO_DATABASE_URL=postgresql://curvestudio:CHANGE_ME_DATABASE_PASSWORD@db:5432/curvestudio

# --- application -----------------------------------------------------------------------------------
# prod: the API refuses to start without the JWT keys below and sends HSTS. Use prod whenever
# the instance is reachable by anyone but you.
CURVESTUDIO_ENV=prod
# Where dev-mode JWT keys and SQLite files would live. This is the mounted volume; keep it.
CURVESTUDIO_DATA_DIR=/data

# RS256 signing pair as single-line PEMs (\n escaped). Generate with deploy/gen-keys.sh:
#   ./gen-keys.sh >> .env   (then delete the placeholder lines it replaces)
# The raw openssl commands, if you prefer them by hand:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out jwt_private.pem
#   openssl pkey -in jwt_private.pem -pubout -out jwt_public.pem
# In prod the API does not start without them. Rotating the pair logs everyone out.
CURVESTUDIO_JWT_PRIVATE_KEY_PEM=
CURVESTUDIO_JWT_PUBLIC_KEY_PEM=

CURVESTUDIO_ACCESS_TTL_MIN=15
CURVESTUDIO_REFRESH_TTL_DAYS=14

# Upload limits: bytes per file and data rows per dataset.
CURVESTUDIO_MAX_UPLOAD_BYTES=20000000
CURVESTUDIO_MAX_ROWS=1000000

# Fit jobs: wall-clock budget per job (s), extra seconds before a stuck worker is killed, and
# the number of worker processes. To handle more load raise CURVESTUDIO_JOB_WORKERS - do NOT
# add app replicas: jobs and the rate limiter live inside the one API process.
CURVESTUDIO_JOB_TIMEOUT_S=120
CURVESTUDIO_JOB_GRACE_S=10
CURVESTUDIO_JOB_WORKERS=2
# Fits waiting for a worker over all users (more are refused with 503), and the largest fit
# result accepted from a job process, in bytes.
CURVESTUDIO_JOB_QUEUE_MAX=500
CURVESTUDIO_JOB_MAX_RESULT_BYTES=250000000

# Uploads are parsed in short-lived subprocesses: budget (s), how many at once, extra memory (MB).
CURVESTUDIO_IMPORT_TIMEOUT_S=20
CURVESTUDIO_IMPORT_CONCURRENCY=2
CURVESTUDIO_IMPORT_MEMORY_MB=1024

# Per-user quota overrides. Empty = the self-hosted plan's defaults (200 datasets, 500 MB of
# dataset data, 2000 stored fits) - self-hosting has no billing and no lower tier.
CURVESTUDIO_QUOTA_MAX_DATASETS=
CURVESTUDIO_QUOTA_MAX_DATASET_BYTES=
CURVESTUDIO_QUOTA_MAX_FITS=

# Seconds between purges of expired refresh tokens and finished jobs.
CURVESTUDIO_HOUSEKEEPING_INTERVAL_S=3600

# Comma-separated extra origins allowed to call the API from a browser. Leave empty: the SPA is
# served by the API itself, same origin. Never "*".
CURVESTUDIO_CORS_ORIGINS=

# Set false to lock a server down to existing accounts.
CURVESTUDIO_REGISTRATION_ENABLED=true
# Billing is off in a self-host: one unlimited "self-hosted" plan, no payment provider calls.
CURVESTUDIO_BILLING_ENABLED=false

# The built SPA is already inside the image at /app/web; keep this value.
CURVESTUDIO_WEB_DIST=/app/web

# Trusted reverse proxies in front of the API. The client address used for rate limiting is
# the Nth entry of X-Forwarded-For counted from the right, N = this number.
#   1 = this compose stack (Caddy only) - the value below.
#   2 = Coolify/Traefik behind Cloudflare (Cloudflare and Traefik both append).
#   0 = the API is reached directly and X-Forwarded-For is ignored.
# Too high lets clients pick their own address; too low rate-limits the proxy as one client.
CURVESTUDIO_TRUSTED_PROXY_HOPS=1

# Process (uvicorn): the container must listen on all interfaces; keep these values.
CURVESTUDIO_HOST=0.0.0.0
CURVESTUDIO_PORT=8000
